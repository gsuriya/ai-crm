# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API Credentials (Required for email personalization and call processing)
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Credentials (for Gmail & Calendar APIs)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VAPI Credentials (for voicemail and voice calls)
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Supabase Database Password (for migrations)
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# Puppeteer Browser Visibility
HEADLESS_BROWSER=true

